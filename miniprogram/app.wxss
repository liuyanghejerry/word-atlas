page {
  background: #f6f1e7;
  color: #1a2035;
  font: 400 28rpx/1.6 -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}
view, text, button, input, scroll-view, image, canvas { box-sizing: border-box; }
button { margin: 0; padding: 0; border: 0; background: none; color: inherit; line-height: inherit; }
button::after { border: 0; }
image { display: block; }
.container { padding: 32rpx 32rpx 64rpx; }
.page-head { margin: 16rpx 0 32rpx; }
.display { display: block; font: 700 52rpx/1.2 "Songti SC", "STSong", serif; letter-spacing: -1rpx; }
.eyebrow { display: block; color: #7a7d8a; font-size: 22rpx; font-weight: 700; letter-spacing: 3rpx; }
.lede { display: block; margin-top: 16rpx; color: #535b70; font-size: 27rpx; }
.muted { color: #7a7d8a; font-size: 24rpx; }
.card, .panel { background: #fffdf8; border: 2rpx solid rgba(26,32,53,.08); border-radius: 32rpx; box-shadow: 0 12rpx 36rpx rgba(30,38,64,.07); }
.panel { padding: 30rpx; margin-bottom: 24rpx; }
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 12rpx; min-height: 84rpx; padding: 0 32rpx; border-radius: 22rpx; font-size: 28rpx; font-weight: 700; }
.btn-primary { background: #1e2640; color: #fffdf8; box-shadow: 0 8rpx 0 #10162a; }
.btn-secondary { background: #dfe9d8; color: #385333; }
.btn-ghost { background: #fffdf8; border: 2rpx solid rgba(26,32,53,.13); }
.btn-terra { background: #c4573a; color: white; }
.btn-block { width: 100%; }
.btn-small { min-height: 64rpx; padding: 0 22rpx; font-size: 24rpx; border-radius: 17rpx; }
.btn[disabled] { opacity: .45; }
.actions { display: flex; gap: 18rpx; align-items: center; flex-wrap: wrap; }
.chips { display: flex; gap: 12rpx; flex-wrap: wrap; margin: 18rpx 0; }
.chip { padding: 10rpx 18rpx; border-radius: 999rpx; background: #eee7d9; color: #535b70; font-size: 23rpx; }
.chip-active { background: #1e2640; color: white; }
.chip-green { background: #dfe9d8; color: #4b6b45; }
.chip-gold { background: #f7e7c4; color: #8b621d; }
.search { display: flex; align-items: center; gap: 14rpx; height: 88rpx; padding: 0 24rpx; margin: 20rpx 0; border: 2rpx solid rgba(26,32,53,.12); border-radius: 24rpx; background: #fffdf8; }
.search input { flex: 1; min-width: 0; font-size: 28rpx; }
.input { width: 100%; min-height: 88rpx; padding: 0 24rpx; border: 2rpx solid rgba(26,32,53,.15); border-radius: 20rpx; background: #fffdf8; }
.progress { height: 12rpx; overflow: hidden; border-radius: 99rpx; background: #e4dac8; }
.progress-bar { height: 100%; border-radius: inherit; background: #6a8c63; transition: width .25s; }
.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.stat { padding: 20rpx 10rpx; text-align: center; }
.stat-value { display: block; font: 700 42rpx/1.1 Georgia, serif; }
.stat-label { display: block; margin-top: 8rpx; color: #7a7d8a; font-size: 22rpx; }
.empty { padding: 80rpx 24rpx; color: #7a7d8a; text-align: center; }
.divider { height: 2rpx; margin: 26rpx 0; background: rgba(26,32,53,.08); }
.speak { display: inline-flex; align-items: center; justify-content: center; gap: 8rpx; min-width: 64rpx; min-height: 64rpx; padding: 0 16rpx; border: 2rpx solid rgba(26,32,53,.1); border-radius: 999rpx; background: #fffdf8; color: #1e2640; font-size: 23rpx; }
.speak-icon { font-size: 27rpx; color: #c4573a; }
.word-card { overflow: hidden; }
.word-art { width: 100%; height: 650rpx; border-radius: 30rpx 30rpx 0 0; background: #eee7d9; }
.word-body { padding: 30rpx; }
.word-tags { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }
.bilingual { display: grid; grid-template-columns: 220rpx 1fr; gap: 26rpx; align-items: center; margin-top: 26rpx; padding: 28rpx; border-radius: 26rpx; background: #faf5ec; }
.hanzi-side { text-align: center; }
.hanzi { display: block; font: 700 138rpx/1.05 "Songti SC", "STSong", serif; }
.pinyin { display: block; margin-top: 12rpx; color: #a8432a; font-size: 30rpx; font-weight: 700; }
.english-side { min-width: 0; padding-left: 26rpx; border-left: 2rpx solid rgba(26,32,53,.12); }
.english { display: block; font: 700 60rpx/1.1 Georgia, serif; overflow-wrap: anywhere; }
.meaning { display: block; margin: 12rpx 0 20rpx; color: #535b70; font-weight: 600; }
.sentence-block { margin-top: 30rpx; }
.sentence { display: flex; gap: 18rpx; align-items: flex-start; margin-top: 22rpx; }
.sentence-badge { flex: none; display: grid; place-items: center; width: 48rpx; height: 48rpx; border-radius: 14rpx; background: #f5ddd1; color: #a8432a; font-size: 20rpx; font-weight: 800; }
.sentence-badge-en { background: #dde8f0; color: #41647e; }
.sentence-text { flex: 1; min-width: 0; font-size: 30rpx; }
.sentence-translation { display: block; margin-top: 6rpx; color: #7a7d8a; font-size: 24rpx; }
.word-friends { display: flex; gap: 14rpx; flex-wrap: wrap; margin-top: 20rpx; }
.friend { display: inline-flex; align-items: center; gap: 8rpx; padding: 12rpx 16rpx; border-radius: 18rpx; background: #faf5ec; font-weight: 600; }
.tip { margin-top: 26rpx; padding: 22rpx; border-radius: 22rpx; background: #f7e7c4; color: #51452e; font-size: 25rpx; }
.hero { position: relative; overflow: hidden; margin-bottom: 28rpx; border-radius: 36rpx; background: #1e2640; color: white; }
.hero-art { width: 100%; height: 390rpx; opacity: .58; }
.hero-body { position: absolute; inset: 0; padding: 38rpx; display: flex; flex-direction: column; justify-content: flex-end; background: linear-gradient(180deg, transparent, rgba(14,18,30,.68)); }
.hero-title { display: block; font: 700 48rpx/1.2 "Songti SC", serif; }
.hero-copy { display: block; margin: 12rpx 0 24rpx; color: rgba(255,255,255,.8); font-size: 25rpx; }
.teaser { display: flex; align-items: center; margin: 12rpx 0 22rpx; }
.teaser image { width: 70rpx; height: 70rpx; margin-right: -14rpx; border: 4rpx solid white; border-radius: 50%; }
.teaser text { margin-left: 28rpx; color: rgba(255,255,255,.78); font-size: 22rpx; }
.daily { display: grid; grid-template-columns: 210rpx 1fr; overflow: hidden; }
.daily image { width: 210rpx; height: 250rpx; }
.daily-body { padding: 24rpx; }
.daily-hanzi { font: 700 68rpx/1 "Songti SC", serif; }
.daily-english { margin-left: 14rpx; font: 700 38rpx Georgia, serif; }
.topic-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.topic { padding: 26rpx 12rpx; border-radius: 24rpx; background: #eee7d9; text-align: center; }
.topic-symbol { display: block; font: 700 56rpx/1.1 "Songti SC", serif; color: #6a8c63; }
.topic-name { display: block; margin-top: 12rpx; font-size: 24rpx; font-weight: 700; }
.topic-count { display: block; color: #7a7d8a; font-size: 20rpx; }
.learn-top { display: grid; grid-template-columns: 64rpx 1fr 90rpx; gap: 20rpx; align-items: center; padding: 22rpx 28rpx; }
.learn-close { font-size: 42rpx; color: #7a7d8a; }
.learn-count { color: #7a7d8a; font-size: 23rpx; text-align: right; }
.stage { padding: 16rpx 30rpx 50rpx; }
.stage-label { display: block; margin: 10rpx 0 24rpx; color: #7a7d8a; font-size: 25rpx; font-weight: 600; }
.next-wrap { position: sticky; bottom: 20rpx; margin-top: 28rpx; }
.prompt { display: grid; place-items: center; min-height: 380rpx; padding: 30rpx 0; }
.prompt-hanzi { font: 700 220rpx/1 "Songti SC", serif; }
.prompt-image { width: 100%; max-height: 540rpx; border-radius: 30rpx; }
.prompt-title { margin-top: 24rpx; font-size: 32rpx; font-weight: 700; }
.listen-orb { display: grid; place-items: center; width: 220rpx; height: 220rpx; border-radius: 50%; background: #1e2640; color: white; font-size: 70rpx; }
.options { display: grid; gap: 18rpx; }
.option { display: flex; align-items: center; justify-content: center; min-height: 100rpx; padding: 20rpx 26rpx; border: 3rpx solid rgba(26,32,53,.12); border-bottom-width: 6rpx; border-radius: 24rpx; background: #fffdf8; font: 700 36rpx Georgia, serif; }
.option-hanzi { font: 700 58rpx "Songti SC", serif; }
.option-answer { border-color: #6a8c63; background: #dfe9d8; }
.option-chosen { border-color: #c4573a; background: #f5ddd1; }
.option-dim { opacity: .42; }
.feedback { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 28rpx 30rpx 42rpx; border-radius: 30rpx 30rpx 0 0; background: #fffdf8; box-shadow: 0 -12rpx 40rpx rgba(30,38,64,.15); }
.feedback-right { color: #4b6b45; }
.feedback-wrong { color: #a8432a; }
.feedback-title { font-size: 32rpx; font-weight: 800; }
.feedback-word { margin: 12rpx 0 24rpx; font-size: 30rpx; }
.summary { text-align: center; }
.summary-score { display: block; margin: 28rpx 0; font: 700 100rpx Georgia, serif; color: #6a8c63; }
.summary-words { display: flex; justify-content: center; flex-wrap: wrap; gap: 16rpx; margin: 26rpx 0; }
.summary-word { padding: 14rpx 20rpx; border-radius: 18rpx; background: #faf5ec; }
.atlas-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.tile { overflow: hidden; border-radius: 26rpx; background: #fffdf8; box-shadow: 0 6rpx 20rpx rgba(30,38,64,.06); }
.tile image { width: 100%; height: 310rpx; }
.tile-body { padding: 18rpx; }
.tile-hanzi { font: 700 58rpx/1 "Songti SC", serif; }
.tile-level { float: right; margin-top: 10rpx; color: #7a7d8a; font-size: 20rpx; }
.tile-english { display: block; margin-top: 10rpx; font: 700 30rpx Georgia, serif; }
.tile-pinyin { display: block; margin-top: 6rpx; color: #7a7d8a; font-size: 22rpx; }
.word-row { display: grid; grid-template-columns: 96rpx 80rpx 1fr 60rpx; gap: 18rpx; align-items: center; padding: 16rpx 0; border-bottom: 2rpx solid rgba(26,32,53,.07); }
.word-row image { width: 96rpx; height: 96rpx; border-radius: 18rpx; }
.row-hanzi { font: 700 48rpx "Songti SC", serif; }
.row-english { font: 700 30rpx Georgia, serif; }
.row-pinyin { display: block; color: #7a7d8a; font-size: 21rpx; }
.galaxy-box { position: relative; height: 620rpx; overflow: hidden; border-radius: 32rpx; background: radial-gradient(circle at 50% 45%, #202c51, #090c18 70%); touch-action: none; }
.galaxy-mini { height: 380rpx; }
.star { position: absolute; width: 12rpx; height: 12rpx; margin: -6rpx; border-radius: 50%; background: #62687a; opacity: .48; }
.star-learning { opacity: 1; box-shadow: 0 0 16rpx currentColor; }
.star-mastered { opacity: 1; background: white !important; box-shadow: 0 0 22rpx white; }
.star-today { opacity: 1; background: #ffd36b !important; box-shadow: 0 0 24rpx #ffd36b; }
.galaxy-caption { position: absolute; left: 26rpx; bottom: 24rpx; color: rgba(255,255,255,.7); font-size: 23rpx; }
.galaxy-label { position: absolute; color: rgba(255,255,255,.48); font-size: 19rpx; pointer-events: none; }
.mode-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.mode-card { padding: 24rpx 10rpx; border: 2rpx solid rgba(26,32,53,.1); border-radius: 22rpx; background: #faf5ec; text-align: center; }
.mode-active { border-color: #c4573a; background: #f5ddd1; }
.mode-title { display: block; font-weight: 700; }
.mode-desc { display: block; margin-top: 8rpx; color: #7a7d8a; font-size: 20rpx; }
.typing-target { margin: 40rpx 0 24rpx; text-align: center; font: 700 52rpx Georgia, serif; }
.typing-image { width: 300rpx; height: 300rpx; margin: 0 auto 24rpx; border-radius: 26rpx; }
.field { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; padding: 22rpx 0; border-bottom: 2rpx solid rgba(26,32,53,.07); }
.field-label { font-weight: 700; }
.field-hint { display: block; color: #7a7d8a; font-size: 21rpx; font-weight: 400; }
.switch { position: relative; width: 88rpx; height: 50rpx; border-radius: 99rpx; background: #d6cdbc; }
.switch-on { background: #6a8c63; }
.switch-dot { position: absolute; top: 5rpx; left: 5rpx; width: 40rpx; height: 40rpx; border-radius: 50%; background: white; transition: left .2s; }
.switch-on .switch-dot { left: 43rpx; }
.onboard { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; padding: 30rpx; background: rgba(14,18,30,.56); }
.onboard-card { width: 100%; max-height: 92vh; overflow-y: auto; padding: 36rpx; border-radius: 36rpx; background: #f6f1e7; }
.level-grid { display: grid; gap: 14rpx; margin: 22rpx 0; }
.level-choice { padding: 22rpx; border: 2rpx solid rgba(26,32,53,.12); border-radius: 22rpx; background: #fffdf8; }
.level-active { border-color: #c4573a; background: #f5ddd1; }
.level-name { display: block; font-weight: 800; }
.level-desc { display: block; color: #7a7d8a; font-size: 23rpx; }
.poster-canvas { position: fixed; left: -2000rpx; top: 0; width: 750rpx; height: 1100rpx; }
.word-nav { display: flex; justify-content: space-between; margin-top: 24rpx; }
